  <data key="d0">Step</data>
  <data key="d1">#F1C40F</data>
  <data key="d3">Marinate the chicken in the yogurt mixture.</data>
  <data key="d4">1</data>
</node>
<node id="[Yogurt Chicken] Step 2">
  <data key="d2">Step 2: Heat oil in a pan and fry...</data>
  <data key="d0">Step</data>
  <data key="d1">#F1C40F</data>
  <data key="d3">Heat oil in a pan and fry the onions until golden brown.</data>
  <data key="d4">2</data>
</node>
<node id="[Yogurt Chicken] Step 3">
  <data key="d2">Step 3: Add the spices and marina...</data>
  <data key="d0">Step</data>
  <data key="d1">#F1C40F</data>
  <data key="d3">Add the spices and marinated chicken, stir, and cover to let it cook.</data>
  <data key="d4">3</data>
</node>
<node id="[Yogurt Chicken] Step 4">
  <data key="d2">Step 4: After 5 minutes, uncover ...</data>
  <data key="d0">Step</data>
  <data key="d1">#F1C40F</data>
  <data key="d3">After 5 minutes, uncover and continue cooking.</data>
  <data key="d4">4</data>
</node>
